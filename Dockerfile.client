FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/client/package.json apps/client/package.json
COPY apps/server/package.json apps/server/package.json
COPY packages/game-config/package.json packages/game-config/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN npm ci
COPY apps/client ./apps/client
COPY packages ./packages
ARG VITE_SERVER_URL
RUN test -n "$VITE_SERVER_URL" && VITE_SERVER_URL="$VITE_SERVER_URL" npm run build -w @tile/client

FROM nginx:1.27-alpine AS client
COPY deploy/nginx-client.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client/dist /usr/share/nginx/html
EXPOSE 80
