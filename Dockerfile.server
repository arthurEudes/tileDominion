FROM rust:1-alpine AS rust-build
WORKDIR /build
COPY apps/simulation-rust/Cargo.toml apps/simulation-rust/Cargo.lock ./
COPY apps/simulation-rust/src ./src
RUN cargo build --release --locked

FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/client/package.json apps/client/package.json
COPY apps/server/package.json apps/server/package.json
COPY packages/game-config/package.json packages/game-config/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN npm ci

FROM node:22-alpine AS server
ENV NODE_ENV=production
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/server/node_modules ./apps/server/node_modules
COPY package.json package-lock.json ./
COPY apps/server ./apps/server
COPY packages ./packages
COPY --from=rust-build /build/target/release/tile-dominion-simulation /app/apps/simulation-rust/target/release/tile-dominion-simulation
USER node
EXPOSE 2567
CMD ["npm", "run", "start", "-w", "@tile/server"]
